{
  "name": "agentprep",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first interview preparation PWA for Agent and LLM roles.",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @agentprep/web --filter @agentprep/server dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:report": "pnpm --filter @agentprep/importers content:report",
    "content:verify": "pnpm --filter @agentprep/importers content:verify",
    "third-party:report": "node tools/quality/third-party-notices.mjs --write",
    "third-party:verify": "node tools/quality/third-party-notices.mjs --check",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @agentprep/e2e test:e2e",
    "build": "pnpm -r --if-present build",
    "performance:check": "node tools/quality/check-bundle.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm content:verify && pnpm third-party:verify && pnpm test && pnpm build && pnpm performance:check && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
